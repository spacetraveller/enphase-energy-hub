ENPHASE_HOST=192.168.1.100
ENPHASE_API_HOST=192.168.1.100
ENPHASE_API_SCHEME=https
ENPHASE_REQUEST_HOST=
ENPHASE_REACHABILITY_PATH=
ENPHASE_REACHABILITY_TARGET=
ENPHASE_SCHEME=http
ENPHASE_PATH=/
ENPHASE_INFO_SCHEME=http
ENPHASE_INFO_PATH=/info
ENPHASE_ACCESS_TOKEN=

PROBE_INTERVAL_SECONDS=30
PRODUCTION_MONITORING_ENABLED=true
PRODUCTION_TOTALS_ENABLED=true
PRODUCTION_TOTALS_PATH=/api/v1/production
PRODUCTION_INVERTERS_ENABLED=true
ENERGY_FLOW_ENABLED=true
ENERGY_FLOW_PATH=/production.json
METER_READINGS_ENABLED=true
PRODUCTION_INTERVAL_SECONDS=30
PRODUCTION_TIMEOUT_SECONDS=15
PROBE_TIMEOUT_SECONDS=5

INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=change-me-now
INFLUXDB_ORG=home
INFLUXDB_BUCKET=enphase
INFLUXDB_TOKEN=change-me-token

# Set both local meter EIDs to enable Grafana production/import/export meter panels.
# Diagnostics can discover them from recent data when these settings are blank.
METER_PRODUCTION_EID=
METER_NET_EID=

GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=admin

WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_TIMEZONE=UTC
# Optional override if historical data uses a different timezone; blank inherits WEATHER_TIMEZONE.
HISTORY_TIMEZONE=
WEATHER_FORECAST_DAYS=4
WEATHER_TIMEOUT_SECONDS=15
PREDICTION_FORECAST_DAYS=3

# Set these to your current tariff values before using cost estimates.
IMPORT_RATE_AUD_PER_KWH=
FEED_IN_RATE_AUD_PER_KWH=

# Optional household scenarios. Leave EV disabled for homes without an EV.
# Enable charger telemetry only if that data is available in InfluxDB.
HOUSEHOLD_EV_ENABLED=false
EV_CHARGER_TELEMETRY_ENABLED=false
# Optional lookback for the telemetry summary when --month is omitted.
EV_TELEMETRY_LOOKBACK_DAYS=180
# Optional local start date for known EV telemetry availability in CSV exports.
EV_CHARGER_TELEMETRY_START_DATE=
# Optional local date when EV charging began changing household demand (YYYY-MM-DD).
HOUSEHOLD_EV_HISTORY_START_DATE=
GREEN_CHARGE_SURPLUS_KW=2.0
# Optional local time window used only to describe a possible hot-water load.
# Leave both blank when the household does not have a known hot-water schedule.
HOUSEHOLD_HOT_WATER_ESTIMATE_START=
HOUSEHOLD_HOT_WATER_ESTIMATE_END=
# Optional container path to a private household calendar JSON file. Blank means none.
HOUSEHOLD_CALENDAR_PATH=

# Enphase Enlighten / API v4 cloud access.
# Keep all real values in .env only. Do not commit API keys, client secrets,
# access tokens, refresh tokens, or authorization codes.
ENPHASE_CLOUD_API_BASE=https://api.enphaseenergy.com/api/v4
ENPHASE_CLOUD_OAUTH_BASE=https://api.enphaseenergy.com/oauth
ENPHASE_CLOUD_AUTHORIZATION_URL=
ENPHASE_CLOUD_REDIRECT_URI=https://api.enphaseenergy.com/oauth/redirect_uri
ENPHASE_CLOUD_CLIENT_ID=
ENPHASE_CLOUD_CLIENT_SECRET=
ENPHASE_CLOUD_API_KEY=
ENPHASE_CLOUD_ACCESS_TOKEN=
ENPHASE_CLOUD_REFRESH_TOKEN=
ENPHASE_CLOUD_AUTH_CODE=
ENPHASE_CLOUD_SYSTEM_ID=
# Optional probe date (YYYY-MM-DD); blank uses yesterday in the configured timezone.
ENPHASE_CLOUD_PROBE_DAY=
# Comma-separated EV charger serial numbers. The IQ2 charger serial may appear
# as a key under /systems/{system_id}/summary -> evse_power.
ENPHASE_CLOUD_EVSE_SERIALS=
ENPHASE_CLOUD_ENDPOINT_LIMIT=6
