    {
      "id": 20,
      "title": "Your solar plan",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 3
      },
      "datasource": {
        "type": "influxdb",
        "uid": "InfluxDB"
      },
      "pluginVersion": "11.6.1",
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 1,
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "**Solar, household energy and optional EV charging — the next three days**\n\nConfigured local time · Household scenarios depend on your setup"
      }
    },
    {
      "id": 21,
      "title": "Forecast age",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 3
      },
      "datasource": {
        "type": "influxdb",
        "uid": "InfluxDB"
      },
      "pluginVersion": "11.6.1",
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "displayName": "Since last update",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 360,
                "color": "orange"
              },
              {
                "value": 720,
                "color": "red"
              }
            ]
          },
          "noValue": "No forecast"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "horizontal"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "InfluxDB"
          },
          "query": "from(bucket:\"enphase\") |> range(start:v.timeRangeStart, stop:v.timeRangeStop)\n |> filter(fn:(r)=>r._measurement==\"enphase_prediction_daily\" and r.model==\"weather_adjusted\" and (r._field==\"fetched_at_unix\" and r.metric==\"Produced\"))\n |> group() |> min()\n |> map(fn:(r)=>({_value:(float(v:uint(v:now()))/1000000000.0-float(v:r._value))/60.0,_field:\"Since forecast update\"}))"
        }
      ]
    },
    {
      "id": 22,
      "title": "Solar generation",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "InfluxDB"
      },
      "pluginVersion": "11.6.1",
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 1,
          "noValue": "Unavailable",
          "color": {
            "mode": "fixed",
            "fixedColor": "#EAB839"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "vertical",
        "justifyMode": "center",
        "text": {
          "valueSize": 42,
          "titleSize": 16
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "InfluxDB"
          },
          "query": "import \"date\"\nimport \"timezone\"\noption location = timezone.location(name:\"__HISTORY_TIMEZONE__\")\nstart=date.add(d:0d,to:date.truncate(t:v.timeRangeStart,unit:1d))\nstop=date.add(d:1d,to:start)\nw=date.weekDay(t:start)\nname=if w==0 then \"Sun\" else if w==1 then \"Mon\" else if w==2 then \"Tue\" else if w==3 then \"Wed\" else if w==4 then \"Thu\" else if w==5 then \"Fri\" else \"Sat\"\nfrom(bucket:\"enphase\") |> range(start:start,stop:stop)\n |> filter(fn:(r)=>r._measurement==\"enphase_prediction_daily\" and r.model==\"weather_adjusted\")\n |> filter(fn:(r)=>r.metric==\"Produced\" and r._field==\"likely_kwh\")\n |> map(fn:(r)=>({_value:r._value,_field:name+\" · \"+r.target_date})) |> group()"
        }
      ]
    },
    {
      "id": 23,
      "title": "Daily energy · kWh",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 6
      },
      "datasource": {
