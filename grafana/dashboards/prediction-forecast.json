                "id": "unit",
                "value": "string"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": false,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "InfluxDB"
          },
          "query": "import \"date\"\nimport \"timezone\"\noption location = timezone.location(name:\"__HISTORY_TIMEZONE__\")\nstart=date.add(d:0d,to:date.truncate(t:v.timeRangeStart,unit:1d))\nstop=date.add(d:1d,to:start)\nfrom(bucket:\"enphase\") |> range(start:start,stop:stop)\n |> filter(fn:(r)=>r._measurement==\"enphase_prediction_daily\" and r.model==\"weather_adjusted\")\n |> filter(fn:(r)=>r._field==\"likely_kwh\" or (r.metric==\"Produced\" and (r._field==\"low_kwh\" or r._field==\"high_kwh\")))\n |> map(fn:(r)=>({Item:if r._field==\"low_kwh\" then \"Solar · lower estimate\" else if r._field==\"high_kwh\" then \"Solar · upper estimate\" else if r.metric==\"Consumed\" then \"Household\" else if r.metric==\"Imported\" then \"Buy from grid\" else if r.metric==\"Exported\" then \"Send to grid\" else \"Solar\",Energy:r._value,order:if r._field==\"low_kwh\" then 4 else if r._field==\"high_kwh\" then 5 else if r.metric==\"Consumed\" then 1 else if r.metric==\"Imported\" then 2 else if r.metric==\"Exported\" then 3 else 0}))\n |> filter(fn:(r)=>r.order>0) |> group() |> sort(columns:[\"order\"]) |> keep(columns:[\"Item\",\"Energy\"])"
        }
      ],
      "description": "Solar ranges are provisional p20–p80 estimates, not guaranteed bounds. Household consumption includes an EV scenario when enabled and supported.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Item": 0,
              "Energy": 1
            },
            "excludeByName": {},
            "renameByName": {}
          }
        }
      ]
    },
